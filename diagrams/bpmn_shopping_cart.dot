digraph G {
    bgcolor="white";
    rankdir=TB;
    splines=ortho;
    nodesep=1.5;
    ranksep=1.0;
    newrank=true;
    compound=true;
    fontname="Times New Roman";
    
    // Default edge style
    edge [fontname="Times New Roman", fontsize=12, color="#555555", penwidth=1.2];

    // Circles
    node [fontname="Times New Roman", fontsize=13, style="filled,bold", shape=circle, width=1.4, height=1.4, fixedsize=true, fillcolor="#E6F2FF", color="#2563EB", fontcolor="#1E3A8A", penwidth=2];
    start [label="Bắt đầu"];
    end_node [label="Kết thúc", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];

    // Diamonds
    node [shape=diamond, width=2.2, height=2.2, fixedsize=true, fillcolor="#FFFBEB", color="#D97706", fontcolor="#000000"];
    check_type [label="Loại SPDV?"];
    check_activation [label="SPDV có\nkích hoạt?"];

    // Boxes
    node [shape=box, style="rounded,filled", width=3.8, height=0.9, fixedsize=true, fillcolor="white", color="#4682B4", fontcolor="#000000", penwidth=1.5];
    add_cart [label="KH add giỏ mua hàng"];
    req_phone [label="Yêu cầu nhập SĐT"];
    req_address [label="Yêu cầu nhập địa chỉ"];
    payment [label="Thanh toán"];
    activate [label="Kích hoạt SPDV"];
    show_thanks_activate [label="Trả thông tin kích hoạt\npage Hoàn tất"];
    show_thanks_no_activate [label="Hiển thị page Hoàn tất"];

    // Relationships
    start -> add_cart;
    add_cart -> check_type;

    check_type -> req_phone [xlabel=" Có YC địa chỉ\nhoặc Hỗn hợp "];
    check_type -> req_address [xlabel=" Không YC địa chỉ "];

    req_phone -> payment;
    req_address -> payment;

    payment -> check_activation [xlabel=" Hoàn tất "];

    check_activation -> activate [xlabel=" Có "];
    check_activation -> show_thanks_no_activate [xlabel=" Không "];
    
    activate -> show_thanks_activate;

    show_thanks_activate -> end_node;
    show_thanks_no_activate -> end_node;

    { rank=same; req_phone; req_address; }
    { rank=same; activate; show_thanks_no_activate; }
}
