digraph G {
    bgcolor="white";
    rankdir=TB;
    splines=ortho;
    nodesep=0.5;
    ranksep=0.8;
    newrank=true;
    compound=true;
    fontname="Times New Roman";
    
    // Default edge style
    edge [fontname="Times New Roman", fontsize=12, color="#555555", penwidth=1.2];
    node [fontname="Times New Roman", fontsize=13, style="filled,bold"];

    // Circles
    node [shape=circle, width=1.4, height=1.4, fixedsize=true, fillcolor="#E6F2FF", color="#2563EB", fontcolor="#1E3A8A", penwidth=2];
    start [label="Bắt đầu"];
    end_node [label="Kết thúc", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D"];

    // Diamonds
    node [shape=diamond, width=2.2, height=2.2, fixedsize=true, fillcolor="#FFFBEB", color="#D97706", fontcolor="#000000"];
    check_type [label="Loại SPDV?"];
    check_activation [label="SPDV có\nkích hoạt?"];

    // Boxes
    node [shape=box, style="rounded,filled", width=3.8, height=0.9, fixedsize=true, fillcolor="white", color="#4682B4", fontcolor="#000000", penwidth=1.5];
    add_cart [label="KH add giỏ mua hàng"];
    req_phone [label="Yêu cầu nhập SĐT"];
    req_address [label="Yêu cầu nhập địa chỉ"];
    payment [label="Thanh toán"];
    activate [label="Kích hoạt SPDV"];
    show_thanks_activate [label="Trả thông tin kích hoạt\npage Hoàn tất"];
    show_thanks_no_activate [label="Hiển thị page Hoàn tất"];

    // Invisible Point Nodes for Routing
    node [shape=point, width=0, height=0, style=invis];
    
    p_type_L; p_type_R;
    p_pay_L; p_pay_C; p_pay_R;
    p_act_L; p_act_R;
    p_end_L; p_end_C; p_end_R;

    // ----- EDGES -----
    start:s -> add_cart:n;
    add_cart:s -> check_type:n;

    // Split 1: Check Type
    { rank=same; p_type_L; check_type; p_type_R; }
    check_type:w -> p_type_L [dir=none, xlabel=" Có YC địa chỉ\nhoặc Hỗn hợp ", fontcolor="#555555"];
    check_type:e -> p_type_R [dir=none, xlabel=" Không YC địa chỉ ", fontcolor="#555555"];
    p_type_L -> req_phone:n;
    p_type_R -> req_address:n;

    // Merge 1: Payment
    { rank=same; p_pay_L; p_pay_C; p_pay_R; }
    req_phone:s -> p_pay_L [dir=none];
    req_address:s -> p_pay_R [dir=none];
    p_pay_L -> p_pay_C [dir=none];
    p_pay_R -> p_pay_C [dir=none];
    p_pay_C -> payment:n;

    payment:s -> check_activation:n [xlabel=" Hoàn tất "];

    // Split 2: Activation
    { rank=same; p_act_L; check_activation; p_act_R; }
    check_activation:w -> p_act_L [dir=none, xlabel=" Có ", fontcolor="#555555"];
    check_activation:e -> p_act_R [dir=none, xlabel=" Không ", fontcolor="#555555"];
    p_act_L -> activate:n;
    p_act_R -> show_thanks_no_activate:n;

    activate:s -> show_thanks_activate:n;

    // Merge 2: End Node
    { rank=same; p_end_L; p_end_C; p_end_R; }
    show_thanks_activate:s -> p_end_L [dir=none];
    show_thanks_no_activate:s -> p_end_R [dir=none];
    p_end_L -> p_end_C [dir=none];
    p_end_R -> p_end_C [dir=none];
    p_end_C -> end_node:n;
}
