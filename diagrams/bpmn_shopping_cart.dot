digraph G {
    bgcolor="#FFFFFF";
    rankdir=TB;
    splines=ortho;
    nodesep=1.0;
    ranksep=0.6;
    newrank=true;
    compound=true;
    fontname="Inter";
    
    // Global Edge Style
    edge [fontname="Inter", fontsize=11, color="#94A3B8", penwidth=2.0, arrowsize=0.7];
    
    // Global Node Style
    node [fontname="Inter", fontsize=13, fontcolor="#1E293B", penwidth=2.0];

    // Circles (Bắt đầu / Kết thúc)
    node [shape=circle, width=1.1, height=1.1, fixedsize=true, style="filled", fillcolor="#EEF2FF", color="#4564ED"];
    start [label="Bắt đầu"];
    
    node [fillcolor="#ECFDF3", color="#17B26A"];
    end_node [label="Kết thúc"];

    // Diamonds (Decision Nodes)
    node [shape=diamond, width=1.8, height=1.8, fixedsize=true, fillcolor="#FFFAEB", color="#F79009"];
    check_type [label="Loại SPDV?"];
    check_activation [label="SPDV có\nkích hoạt?"];

    // Boxes (Process Nodes)
    node [shape=box, style="filled,rounded", width=3.4, height=0.7, fixedsize=true, fillcolor="#FFFFFF", color="#4564ED"];
    add_cart [label="KH add giỏ mua hàng"];
    req_phone [label="Yêu cầu nhập SĐT"];
    req_address [label="Yêu cầu nhập địa chỉ"];
    payment [label="Thanh toán"];
    activate [label="Kích hoạt SPDV"];
    show_thanks_activate [label="Trả thông tin kích hoạt\npage Hoàn tất"];
    show_thanks_no_activate [label="Hiển thị page Hoàn tất"];

    // Invisible Point Nodes for Perfect Orthogonal Routing
    node [shape=point, width=0, height=0, style=invis];
    p_tL; p_tR;
    p_pL; p_pC; p_pR;
    p_aL; p_aR;
    p_eL; p_eC; p_eR;

    // ============ ROUTING ============
    start -> add_cart;
    add_cart -> check_type;

    // Split 1
    { rank=same; p_tL; check_type; p_tR; }
    check_type -> p_tL [dir=none, label=" Có YC địa chỉ\nhoặc Hỗn hợp ", fontcolor="#64748B"];
    check_type -> p_tR [dir=none, label=" Không YC địa chỉ ", fontcolor="#64748B"];
    p_tL -> req_phone;
    p_tR -> req_address;

    // Merge 1
    { rank=same; p_pL; p_pC; p_pR; }
    req_phone -> p_pL [dir=none];
    req_address -> p_pR [dir=none];
    p_pL -> p_pC [dir=none];
    p_pR -> p_pC [dir=none];
    p_pC -> payment;

    payment -> check_activation [label=" Hoàn tất ", fontcolor="#64748B"];

    // Split 2
    { rank=same; p_aL; check_activation; p_aR; }
    check_activation -> p_aL [dir=none, label=" Có ", fontcolor="#64748B"];
    check_activation -> p_aR [dir=none, label=" Không ", fontcolor="#64748B"];
    p_aL -> activate;
    p_aR -> show_thanks_no_activate;

    // Merge 2
    activate -> show_thanks_activate;
    { rank=same; p_eL; p_eC; p_eR; }
    show_thanks_activate -> p_eL [dir=none];
    show_thanks_no_activate -> p_eR [dir=none];
    p_eL -> p_eC [dir=none];
    p_eR -> p_eC [dir=none];
    p_eC -> end_node;

    { rank=same; req_phone; req_address; }
    { rank=same; activate; show_thanks_no_activate; }
}
