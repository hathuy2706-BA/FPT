digraph G {
    bgcolor="white";
    rankdir=TB;
    splines=ortho;
    nodesep=1.0;
    ranksep=1.0;
    newrank=true;
    compound=true;
    fontname="Times New Roman";
    
    node [fontname="Times New Roman", fontsize=13, shape=box, style="rounded,filled", fillcolor="white", color="#4682B4", penwidth=1.5, margin=0.15];
    edge [fontname="Times New Roman", fontsize=12, color="#555555", penwidth=1.2];

    start [label="Bắt đầu: Mua hàng\n(Luồng Giỏ Hàng)", shape=oval, style="filled,bold", fillcolor="#E6F2FF", color="#2563EB", fontcolor="#1E3A8A", penwidth=2, margin=0.2];
    
    check_type [label="Loại Sản phẩm/Dịch vụ (SPDV)?", shape=diamond, width=1.5, height=1.5, color="#D97706", fillcolor="#FFFBEB"];

    req_phone [label="Yêu cầu nhập SĐT"];
    req_address [label="Yêu cầu Địa chỉ"];
    
    payment [label="Thanh toán"];
    
    check_activation [label="Kiểm tra SPDV\ncó kích hoạt?", shape=diamond, width=1.5, height=1.5, color="#D97706", fillcolor="#FFFBEB"];
    
    activate [label="Kích hoạt SPDV"];
    
    show_thanks_activate [label="Trả thông tin hiển thị\nPage Cảm ơn", shape=oval, style="filled,bold", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", penwidth=2];
    show_thanks_no_activate [label="Hiển thị Page Cảm ơn", shape=oval, style="filled,bold", fillcolor="#DCFCE7", color="#16A34A", fontcolor="#14532D", penwidth=2];

    start -> check_type;

    check_type -> req_phone [xlabel=" Nhánh 1: Mua SPDV có YC địa chỉ\nhoặc Hỗn hợp SPDV "];
    check_type -> req_address [xlabel=" Nhánh 2: Mua SPDV\nkhông YC địa chỉ "];

    req_phone -> payment;
    req_address -> payment;

    payment -> check_activation [label=" Hoàn tất thanh toán "];

    check_activation -> activate [xlabel=" Có kích hoạt "];
    check_activation -> show_thanks_no_activate [xlabel=" Không kích hoạt "];
    
    activate -> show_thanks_activate;

    { rank=same; req_phone; req_address; }
    { rank=same; activate; show_thanks_no_activate; }
}
