
digraph G {

    rankdir=TB;
    splines=ortho;
    nodesep=0.4;
    ranksep=0.4;
    newrank=true;
    compound=true;
    fontname="Arial";
    
    // Default node style
    node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#4682B4", penwidth=1.0, margin=0.1];
    edge [fontname="Arial", fontsize=9, color="#555555", penwidth=1.0];

    subgraph cluster_customer {
        style=filled; color="#CBD5E1"; fillcolor="#F0F4F8"; penwidth=1; label=""; margin=10;
        h_cust [label="KHÁCH HÀNG (CUSTOMER)", shape=box, style="filled", fillcolor="#28547B", color="#28547B", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        start [label="Bắt đầu", shape=circle, style="filled", fillcolor="white", color="#22C55E", fontcolor="#22C55E", penwidth=2, width=0.6, fixedsize=true];
        select_addon [label="Chọn Add-on\nUltraFast"];
        link_contract [label="Nhập Mã hợp đồng\nInternet hiện hữu"];
        h_cust -> start [style=invis];
    }
    subgraph cluster_fe {
        style=filled; color="#CBD5E1"; fillcolor="#E6F2FF"; penwidth=1; label=""; margin=10;
        h_fe [label="WEBSITE FPT.VN (FRONTEND)", shape=box, style="filled", fillcolor="#4682B4", color="#4682B4", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        display_success [label="Hiển thị thông báo\nthành công"];
        h_fe -> display_success [style=invis];
    }
    subgraph cluster_be {
        style=filled; color="#CBD5E1"; fillcolor="#F8F0F8"; penwidth=1; label=""; margin=10;
        h_be [label="BACKEND & TÍCH HỢP", shape=box, style="filled", fillcolor="#8B008B", color="#8B008B", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        verify_contract [label="Verify Hạ tầng &\nTrạng thái HĐ"];
        bind_addon [label="Gộp UltraFast\nvào Giỏ hàng"];
        end [label="Hoàn thành", shape=doublecircle, style="filled", fillcolor="white", color="#EF4444", fontcolor="#EF4444", penwidth=2, width=0.6, fixedsize=true];
        h_be -> verify_contract [style=invis];
    }
    { rank=same; h_cust; h_fe; h_be; }
    
    start -> select_addon -> link_contract -> verify_contract -> bind_addon -> display_success -> end;
}
