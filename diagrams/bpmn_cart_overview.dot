
digraph G {
    rankdir=LR; bgcolor="white";
    node [fontname="Arial", fontsize=10, shape=box, style="filled,rounded", fillcolor="#F8FAFC", color="#475569", linewidth=1.5];
    edge [fontname="Arial", fontsize=9, color="#334155", fontcolor="#0F172A"];

    subgraph cluster_client {
        label="Khách Hàng (User)"; style=filled; color="#CBD5E1"; fillcolor="#F8FAFC";
        start [label="Bắt đầu
(Xem SP)", shape=circle, fillcolor="#22C55E", fontcolor="white", width=0.8, fixedsize=true];
        add_to_cart [label="Click 'Thêm vào giỏ'
/ 'Mua ngay'"];
        view_cart [label="Truy cập Trang Giỏ hàng
(Cart View)"];
        update_qty [label="Điều chỉnh Số lượng
/ Nhập Voucher"];
        click_checkout [label="Click 'Tiến hành
thanh toán'"];
    }

    subgraph cluster_fe {
        label="Website FPT.vn Frontend"; style=filled; color="#CBD5E1"; fillcolor="#F8FAFC";
        render_cart [label="Hiển thị danh sách SP,
Gói cước & Giá tạm tính"];
        validate_input [label="Validate Client-side
(SL, Format Mã)"];
        store_session [label="Lưu LocalSession
/ Sync Auth Cookie"];
    }

    subgraph cluster_be {
        label="Cart Service & Inventory API"; style=filled; color="#94A3B8"; fillcolor="#EFF6FF";
        check_inv [label="Check Kho SKU &
Hạ tầng SA theo Geo"];
        calc_price [label="Tính Pricing Matrix,
Discount & Cross-sell"];
        lock_cart [label="Tạo Draft Order
& Khóa Session Giỏ"];
    }

    subgraph cluster_oms {
        label="Checkout System (OMS)"; style=filled; color="#CBD5E1"; fillcolor="#F0FDF4";
        end [label="Chuyển hướng
Checkout Page", shape=doublecircle, fillcolor="#EF4444", fontcolor="white", width=0.8, fixedsize=true];
    }

    start -> add_to_cart -> validate_input -> check_inv -> calc_price -> render_cart -> view_cart -> update_qty -> calc_price;
    view_cart -> click_checkout -> store_session -> lock_cart -> end;
}
