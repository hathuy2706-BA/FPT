
digraph G {

    rankdir=TB;
    splines=ortho;
    nodesep=0.4;
    ranksep=0.4;
    newrank=true;
    compound=true;
    fontname="Arial";
    
    // Default node style
    node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#4682B4", penwidth=1.0, margin=0.1];
    edge [fontname="Arial", fontsize=9, color="#555555", penwidth=1.0];

    
    subgraph cluster_customer {
        style=filled; color="#CBD5E1"; fillcolor="#F0F4F8"; penwidth=1; label=""; margin=10;
        h_cust [label="KHÁCH HÀNG (CUSTOMER)", shape=box, style="filled", fillcolor="#28547B", color="#28547B", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        start [label="Bắt đầu", shape=circle, style="filled", fillcolor="white", color="#22C55E", fontcolor="#22C55E", penwidth=2, width=0.6, fixedsize=true];
        add_to_cart [label="Chọn SP trên web\nbấm 'Thêm vào giỏ'"];
        view_cart [label="Truy cập\nTrang Giỏ hàng"];
        update_qty [label="Điều chỉnh Số lượng\n/ Nhập Voucher"];
        click_checkout [label="Bấm 'Tiến hành\nthanh toán'"];
        h_cust -> start [style=invis];
    }

    subgraph cluster_fe {
        style=filled; color="#CBD5E1"; fillcolor="#E6F2FF"; penwidth=1; label=""; margin=10;
        h_fe [label="WEBSITE FPT.VN (FRONTEND)", shape=box, style="filled", fillcolor="#4682B4", color="#4682B4", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        validate_input [label="Validate Client-side\n(SL, Format Mã)"];
        render_cart [label="Hiển thị Giỏ hàng\n& Giá tạm tính"];
        store_session [label="Lưu LocalSession\n/ Sync Auth Cookie"];
        h_fe -> validate_input [style=invis];
    }

    subgraph cluster_be {
        style=filled; color="#CBD5E1"; fillcolor="#F8F0F8"; penwidth=1; label=""; margin=10;
        h_be [label="BACKEND & TÍCH HỢP", shape=box, style="filled", fillcolor="#8B008B", color="#8B008B", fontcolor="white", fontsize=11, fontname="Arial bold", width=2.0, height=0.4, fixedsize=false];
        check_inv [label="Check Kho SKU &\nHạ tầng SA"];
        calc_price [label="Tính Pricing Matrix,\nDiscount & Cross-sell"];
        lock_cart [label="Tạo Draft Order\n& Khóa Session"];
        end [label="Chuyển hướng\nCheckout", shape=doublecircle, style="filled", fillcolor="white", color="#EF4444", fontcolor="#EF4444", penwidth=2, width=0.6, fixedsize=true];
        h_be -> check_inv [style=invis];
    }

    // Align headers
    { rank=same; h_cust; h_fe; h_be; }

    start -> add_to_cart;
    add_to_cart -> validate_input;
    validate_input -> check_inv;
    check_inv -> calc_price;
    calc_price -> render_cart;
    render_cart -> view_cart;
    view_cart -> update_qty;
    update_qty -> validate_input;
    view_cart -> click_checkout;
    click_checkout -> store_session;
    store_session -> lock_cart;
    lock_cart -> end;
}
