
digraph G {

    rankdir=TB;
    splines=ortho;
    nodesep=0.8;
    ranksep=0.8;
    node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#4682B4", penwidth=1.2, width=2.5, height=0.6];
    edge [fontname="Arial", fontsize=9, color="#555555", penwidth=1.0];


    subgraph cluster_customer {
        label="KHÁCH HÀNG (CUSTOMER)";
        style=filled; color="#28547B"; fillcolor="#F0F4F8"; penwidth=2;
        fontcolor="#28547B"; fontsize=12; fontname="Arial bold"; labelloc="t"; labeljust="c";

        start [label="Bắt đầu", shape=circle, style="filled", fillcolor="white", color="#22C55E", fontcolor="#22C55E", penwidth=2, width=0.7, fixedsize=true];
        add_to_cart [label="Chọn SP trên web\nbấm 'Thêm vào giỏ'"];
        view_cart [label="Truy cập\nTrang Giỏ hàng"];
        update_qty [label="Điều chỉnh Số lượng\n/ Nhập Voucher"];
        click_checkout [label="Bấm 'Tiến hành\nthanh toán'"];
    }

    subgraph cluster_fe {
        label="WEBSITE FPT.VN (FRONTEND)";
        style=filled; color="#4682B4"; fillcolor="#E6F2FF"; penwidth=2;
        fontcolor="#4682B4"; fontsize=12; fontname="Arial bold"; labelloc="t"; labeljust="c";

        render_cart [label="Hiển thị Giỏ hàng\n& Giá tạm tính"];
        validate_input [label="Validate Client-side\n(SL, Format Mã)"];
        store_session [label="Lưu LocalSession\n/ Sync Auth Cookie"];
    }

    subgraph cluster_be {
        label="BACKEND & TÍCH HỢP";
        style=filled; color="#8B008B"; fillcolor="#F8F0F8"; penwidth=2;
        fontcolor="#8B008B"; fontsize=12; fontname="Arial bold"; labelloc="t"; labeljust="c";

        check_inv [label="Check Kho SKU &\nHạ tầng SA"];
        calc_price [label="Tính Pricing Matrix,\nDiscount & Cross-sell"];
        lock_cart [label="Tạo Draft Order\n& Khóa Session"];
        end [label="Chuyển hướng\nCheckout", shape=doublecircle, style="filled", fillcolor="white", color="#EF4444", fontcolor="#EF4444", penwidth=2, width=0.7, fixedsize=true];
    }

    start -> add_to_cart -> validate_input -> check_inv -> calc_price -> render_cart -> view_cart -> update_qty -> validate_input;
    view_cart -> click_checkout -> store_session -> lock_cart -> end;
}
