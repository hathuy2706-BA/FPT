    <tbody>
        <tr><td><b>Stepper Số lượng</b></td><td>PDP / Giỏ</td><td style="text-align:center;">Có</td><td>Số nguyên &ge; 1; giới hạn theo QLCS.</td></tr>
        <tr><td><b>Giá &amp; % giảm</b></td><td>PDP / Giỏ</td><td style="text-align:center;">&ndash;</td><td>Giá gốc gạch ngang + giá sau giảm (VD 2.750.000đ &minus;20%); nạp động.</td></tr>
        <tr><td><b>Nút "Thêm giỏ" / "Mua ngay"</b></td><td>PDP</td><td style="text-align:center;">&ndash;</td><td>"Thêm giỏ": ở lại PDP + toast; "Mua ngay": chuyển thẳng giỏ/checkout.</td></tr>
        <tr><td><b>Địa chỉ giao hàng</b></td><td>Checkout</td><td style="text-align:center;">Có</td><td>Bắt buộc (thiết bị vật lý); xác định vùng phục vụ &amp; COD.</td></tr>
        <tr><td><b>Phương thức thanh toán</b></td><td>Checkout</td><td style="text-align:center;">Có</td><td>Danh sách động; COD ẩn ở vùng cấm.</td></tr>
    </tbody>
</table>

