            <td style="font-weight: bold; color: green; text-align: center;">X</td>
            <td style="font-weight: bold; color: green; text-align: center;">X</td>
            <td style="text-align: center;">-</td>
            <td style="font-weight: bold; color: green; text-align: center;">X</td>
        </tr>
