            <th>Cấu hình luật đồng bộ (CMS)</th>
            <th>Bypass đồng bộ chu kỳ (Đơn hàng đặc biệt)</th>
            <th>Ghi log lỗi đồng bộ</th>
        </tr>
    </thead>
