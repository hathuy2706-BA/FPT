                    <td><strong>FPT Camera IQ4S (Dòng 1)</strong><br><span style="font-size: 10pt; color: #555;">Dịch vụ đi kèm: Gói Cloud 3 ngày - Trả trước 6 tháng</span></td>
                    <td style="text-align: center;">900.000đ</td>
                    <td style="text-align: center;">240.000đ</td>
                    <td style="text-align: center;">1</td>
                    <td style="text-align: center; font-weight: bold;">1.140.000đ</td>
                </tr>
                <tr>
                    <td style="text-align: center;"><input type="checkbox" checked disabled/></td>
                    <td><strong>FPT Camera IQ4S (Dòng 2)</strong><br><span style="font-size: 10pt; color: #555;">Dịch vụ đi kèm: Gói Cloud 3 ngày - Trả trước 12 tháng</span></td>
                    <td style="text-align: center;">900.000đ</td>
                    <td style="text-align: center;">480.000đ</td>
                    <td style="text-align: center;">1</td>
                    <td style="text-align: center; font-weight: bold;">1.380.000đ</td>
                </tr>
                <tr>
                    <td style="text-align: center;"><input type="checkbox" checked disabled/></td>
                    <td><strong>FPT Camera IQ4S (Dòng 3)</strong><br><span style="font-size: 10pt; color: #555;">Dịch vụ đi kèm: Gói Cloud 7 ngày - Trả trước 6 tháng</span></td>
                    <td style="text-align: center;">900.000đ</td>
                    <td style="text-align: center;">360.000đ</td>
                    <td style="text-align: center;">1</td>
                    <td style="text-align: center; font-weight: bold;">1.260.000đ</td>
                </tr>
                <tr>
                    <td style="text-align: center;"><input type="checkbox" checked disabled/></td>
                    <td><strong>FPT Camera IQ4S (Dòng 4)</strong><br><span style="font-size: 10pt; color: #555;">Dịch vụ đi kèm: Gói Cloud 7 ngày - Trả trước 12 tháng</span></td>
                    <td style="text-align: center;">900.000đ</td>
                    <td style="text-align: center;">720.000đ</td>
                    <td style="text-align: center;">1</td>
