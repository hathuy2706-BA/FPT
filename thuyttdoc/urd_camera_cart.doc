                    <td style="text-align: center;">900.000đ</td>
                    <td style="text-align: center;">360.000đ</td>
                    <td style="text-align: center;">1</td>
                    <td style="text-align: center; font-weight: bold;">1.260.000đ</td>
                </tr>
