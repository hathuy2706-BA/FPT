    <thead><tr><th style="width:10%; text-align:center;">M&atilde;</th><th style="width:38%;">T&ecirc;n ch&#7913;c n&#259;ng</th><th style="width:18%; text-align:center;">&Aacute;p d&#7909;ng</th><th style="width:17%; text-align:center;">Th&#7921;c hi&#7879;n b&#7903;i</th><th style="width:17%; text-align:center;">&#431;u ti&ecirc;n</th></tr></thead>
