        <tr><td style="text-align:center;">F-02</td><td>Hi&#7875;n th&#7883; section &#8220;&#431;u &#273;&atilde;i&#8221; t&#7841;i Gi&#7887; h&agrave;ng</td><td style="text-align:center;">vcp2sku</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-03</td><td>M&#7903; popup danh s&aacute;ch voucher</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-04</td><td>Hi&#7875;n th&#7883; voucher: Active tr&#432;&#7899;c, Inactive m&#7901;; scroll &gt;452px</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-05</td><td>Nh&#7853;p m&atilde; tay + b&#7845;m &#8220;&Aacute;p d&#7909;ng&#8221;</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-06</td><td>Ch&#7885;n voucher t&#7915; popup + b&#7845;m &#8220;S&#7917; d&#7909;ng &#432;u &#273;&atilde;i&#8221;</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-07</td><td>G&#7885;i API validate voucher &amp; t&iacute;nh gi&#7843;m gi&aacute;</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">BE/ECP</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-08</td><td>C&#7853;p nh&#7853;t t&#7893;ng ti&#7873;n sau khi &aacute;p d&#7909;ng th&agrave;nh c&ocirc;ng</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-09</td><td>Hi&#7875;n th&#7883; th&ocirc;ng b&aacute;o l&#7895;i chi ti&#7871;t</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-10</td><td>Disable voucher kh&ocirc;ng &#273;&#7911; &#273;i&#7873;u ki&#7879;n (m&#7901; trong popup)</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Trung b&igrave;nh</td></tr>
        <tr><td style="text-align:center;">F-11</td><td>Label D-3 c&#7843;nh b&aacute;o s&#7855;p h&#7871;t h&#7841;n (&le;3 ng&agrave;y)</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Trung b&igrave;nh</td></tr>
        <tr><td style="text-align:center;">F-12</td><td>G&#7905; b&#7887; voucher &#273;ang &aacute;p d&#7909;ng</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-13</td><td>Validate PTTT, &#273;&#417;n t&#7889;i thi&#7875;u, SL SP, khu v&#7921;c, lo&#7841;i tr&#7915;</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">BE/ECP</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-14</td><td>Re-validate khi gi&#7887; h&agrave;ng thay &#273;&#7893;i</td><td style="text-align:center;">vcp2sku</td><td style="text-align:center;">BE/ECP</td><td style="text-align:center;">Cao</td></tr>
        <tr><td style="text-align:center;">F-15</td><td>Hi&#7875;n th&#7883; &#8220;Kh&ocirc;ng c&oacute; m&atilde; &#432;u &#273;&atilde;i&#8221; khi DS r&#7895;ng</td><td style="text-align:center;">C&#7843; hai</td><td style="text-align:center;">FE</td><td style="text-align:center;">Cao</td></tr>
